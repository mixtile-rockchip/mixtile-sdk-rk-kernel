/* edp0 display */

&edp0 {
	pinctrl-names = "default";
	pinctrl-0 = <&edp0_hpd>;
	hpd-gpios = <&gpio4 RK_PB4 GPIO_ACTIVE_HIGH>;
	#sound-dai-cells = <1>;
	status = "okay";

	ports {
		port@1 {
			reg = <1>;
			edp0_out_dp_con: endpoint {
				remote-endpoint = <&dp_con_in_edp0>;
			};
		};
	};
};


