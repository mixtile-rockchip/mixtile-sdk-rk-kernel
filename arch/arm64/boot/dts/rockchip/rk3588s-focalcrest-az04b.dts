	status = "okay";
};

&hdmi0 {
        status = "disabled";
};

&hdptxphy_hdmi0 {
        status = "disabled";
};

&route_hdmi0 {
        status = "disabled";
};

/* MIPI DSI0 Display */
&dsi0 {
	rockchip,lane-rate = <348>;
        status = "okay";

        dsi0_panel: panel@0 {
                status = "okay";
		compatible = "simple-panel-dsi";
                reg = <0>;
		power-supply = <&vcc5v0_mipi0>;
                reset-gpios = <&gpio3 RK_PB3 GPIO_ACTIVE_LOW>;
                enable-gpios = <&gpio1 RK_PA4 GPIO_ACTIVE_HIGH>;
                pinctrl-names = "default";
                pinctrl-0 = <&mipi0_rst_gpio>;
                prepare-delay-ms = <0>;
                reset-delay-ms = <0>;
                init-delay-ms = <0>;
                enable-delay-ms = <0>;
                disable-delay-ms = <0>;
                unprepare-delay-ms = <0>;
		bpc = <8>;
                width-mm = <154>;
                height-mm = <86>;
                dsi,flags = <(MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST | MIPI_DSI_MODE_LPM )>;
                dsi,format = <MIPI_DSI_FMT_RGB888>;
                dsi,lanes = <4>;

                panel-init-sequence = [
                        05 ff 01 11
                        05 ff 01 29
                ];

                panel-exit-sequence = [
                        05 00 01 28
                        05 00 01 10
                ];

                display-timings {
                        native-mode = <&timing0>;

                        timing0: timing0 {
                                clock-frequency = <52000000>;
                                hactive = <1024>;
                                vactive = <600>;
                                hfront-porch = <150>;
                                hsync-len = <30>;
                                hback-porch = <150>;
                                vfront-porch = <10>;
                                vsync-len = <20>;
                                vback-porch = <10>;
                                hsync-active = <0>;
                                vsync-active = <0>;
                                de-active = <0>;
                                pixelclk-active = <1>;
                     };
                };


                ports {
                        #address-cells = <1>;
                        #size-cells = <0>;

                        port@0 {
                                reg = <0>;
                                panel_in_dsi0: endpoint {
                                        remote-endpoint = <&dsi0_out_panel>;
                                };
                        };
                };
        };

        ports {
                #address-cells = <1>;
                #size-cells = <0>;

                port@1 {
                        reg = <1>;
                        dsi0_out_panel: endpoint {
                                remote-endpoint = <&panel_in_dsi0>;
                        };
                };
        };
};

&dsi0_in_vp2 {
	status = "okay";
};

&dsi0_in_vp3 {
	status = "disabled";
};

&route_dsi0 {
	status = "okay";
	connect = <&vp2_out_dsi0>;
};

&mipi_dcphy0 {
	status = "okay";
};

&i2c5 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c5m1_xfer>;
	status = "okay";

        gt9xx_0: gt9xx-0@14 {
                compatible = "goodix,gt9xx";
                reg = <0x14>;
                pinctrl-names = "default";
                pinctrl-0 = <&tp0_int>;
                touch-gpio = <&gpio4 RK_PC1 GPIO_ACTIVE_HIGH>;
                reset-gpio = <&gpio4 RK_PC0 GPIO_ACTIVE_HIGH>;
                max-x = <4096>;
                max-y = <4096>;
		tp-size = <910>;
		index= <1>;
                wakeup-source;
	};

};


/* MIPI DSI1 Display */

&dsi1 {
	rockchip,lane-rate = <348>;
        status = "okay";

        dsi1_panel: panel@1 {
                status = "okay";
		compatible = "simple-panel-dsi";
                reg = <0>;
		power-supply = <&vcc5v0_mipi1>;
                reset-gpios = <&gpio3 RK_PB4 GPIO_ACTIVE_LOW>;
                enable-gpios = <&gpio1 RK_PA5 GPIO_ACTIVE_HIGH>;
                pinctrl-names = "default";
                pinctrl-0 = <&mipi1_rst_gpio>;
                prepare-delay-ms = <0>;
                reset-delay-ms = <0>;
                init-delay-ms = <0>;
                enable-delay-ms = <0>;
                disable-delay-ms = <0>;
                unprepare-delay-ms = <0>;
		bpc = <8>;
                width-mm = <154>;
                height-mm = <86>;
                dsi,flags = <(MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST | MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_NO_EOT_PACKET)>;
                dsi,format = <MIPI_DSI_FMT_RGB888>;
                dsi,lanes = <4>;

                panel-init-sequence = [
                        05 ff 01 11
                        05 ff 01 29
                ];

                panel-exit-sequence = [
                        05 00 01 28
                        05 00 01 10
                ];

                display-timings {
                        native-mode = <&timing1>;

                        timing1: timing1 {
                                clock-frequency = <52000000>;
                                hactive = <1024>;
                                vactive = <600>;
                                hfront-porch = <150>;
                                hsync-len = <30>;
                                hback-porch = <150>;
                                vfront-porch = <10>;
                                vsync-len = <20>;
                                vback-porch = <10>;
                                hsync-active = <0>;
                                vsync-active = <0>;
                                de-active = <0>;
                                pixelclk-active = <1>;
                     };
		};

                ports {
                        #address-cells = <1>;
                        #size-cells = <0>;

                        port@0 {
                                reg = <0>;
                                panel_in_dsi1: endpoint {
                                        remote-endpoint = <&dsi1_out_panel>;
                                };
                        };
                };
        };

        ports {
                #address-cells = <1>;
                #size-cells = <0>;

                port@1 {
                        reg = <1>;
                        dsi1_out_panel: endpoint {
                                remote-endpoint = <&panel_in_dsi1>;
                        };
                };
        };
};

&dsi1_in_vp2 {
	status = "disabled";
};

&dsi1_in_vp3 {
	status = "okay";
};

&route_dsi1 {
	status = "okay";
	connect = <&vp3_out_dsi1>;
};

&mipi_dcphy1 {
	status = "okay";
};

&i2c4 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4m3_xfer>;
	status = "okay";

        gt9xx_1: gt9xx-1@14 {
                compatible = "goodix,gt9xx";
                reg = <0x14>;
                pinctrl-names = "default";
                pinctrl-0 = <&tp1_int>;
                touch-gpio = <&gpio1 RK_PA1 GPIO_ACTIVE_HIGH>;
                reset-gpio = <&gpio1 RK_PA0 GPIO_ACTIVE_HIGH>;
                max-x = <4096>;
                max-y = <4096>;
		tp-size = <910>;
		index = <2>;
                wakeup-source;
        };

};


&vop {
	status = "okay";
	assigned-clocks = <&cru ACLK_VOP>;
	assigned-clock-rates = <800000000>;
};

&vop_mmu {
	status = "okay";
};

/* vp0 & vp1 splice for 8K output */
&vp0 {
	rockchip,plane-mask = <(1 << ROCKCHIP_VOP2_CLUSTER0 | 1 << ROCKCHIP_VOP2_ESMART0)>;
	rockchip,primary-plane = <ROCKCHIP_VOP2_ESMART0>;
	cursor-win-id = <ROCKCHIP_VOP2_CLUSTER0>;
};

&vp1 {
	rockchip,plane-mask = <(1 << ROCKCHIP_VOP2_CLUSTER1 | 1 << ROCKCHIP_VOP2_ESMART1)>;
	rockchip,primary-plane = <ROCKCHIP_VOP2_ESMART1>;
	cursor-win-id = <ROCKCHIP_VOP2_CLUSTER1>;
};

&vp2 {
	rockchip,plane-mask = <(1 << ROCKCHIP_VOP2_CLUSTER2 | 1 << ROCKCHIP_VOP2_ESMART2)>;
	rockchip,primary-plane = <ROCKCHIP_VOP2_ESMART2>;
	cursor-win-id = <ROCKCHIP_VOP2_CLUSTER2>;
};

&vp3 {
	rockchip,plane-mask = <(1 << ROCKCHIP_VOP2_CLUSTER3 | 1 << ROCKCHIP_VOP2_ESMART3)>;
	rockchip,primary-plane = <ROCKCHIP_VOP2_ESMART3>;
	cursor-win-id = <ROCKCHIP_VOP2_CLUSTER3>;
};

&pinctrl {
	hym8563 {
		hym8563_int: hym8563-int {
			rockchip,pins = <0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	fan {
		fan_vbus_en: fan-vbus-en {
			rockchip,pins = <1 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	headphone {
		hp_det: hp-det {
			rockchip,pins = <1 RK_PC0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	usb-typec {
		usbc0_int: usbc0-int {
			rockchip,pins = <1 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		typec_vbus_en: typec-vbus-en {
			rockchip,pins = <3 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	usb {
		usb30_host_pwr_en: usb30-host-pwr-en {
			rockchip,pins = <3 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		usb20_host_pwr_en: usb20-host-pwr-en {
			rockchip,pins = <3 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	pmic {
		az04b_pmic_pins: az04b-pmic-pins {
			rockchip,pins = <0 RK_PA7 RK_FUNC_GPIO &pcfg_pull_up>,
					<0 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>,
					<0 RK_PA3 RK_FUNC_GPIO &pcfg_pull_none>,
					<0 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>,
					<0 RK_PC3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	leds {
		sys_status_led_pin: sys-status-led-pin {
			rockchip,pins = <0 RK_PC2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	edp {
		edp0_hpd: edp0-hpd {
			rockchip,pins = <4 RK_PB4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

        mipi0 {
                mipi0_rst_gpio: mipi0-rst-gpio {
                        rockchip,pins = <3 RK_PB3 RK_FUNC_GPIO &pcfg_pull_none>,
					<1 RK_PA4 RK_FUNC_GPIO &pcfg_pull_none>;
                };
        };

        mipi1 {
                mipi1_rst_gpio: mipi1-rst-gpio {
                        rockchip,pins = <3 RK_PB4 RK_FUNC_GPIO &pcfg_pull_none>,
					<1 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;
                };
        };

        tp {
                tp0_int: tp0-int {
                        rockchip,pins =
                                <4 RK_PC1 RK_FUNC_GPIO &pcfg_pull_up>;
                };

                tp1_int: tp01int {
                        rockchip,pins =
                                <1 RK_PA1 RK_FUNC_GPIO &pcfg_pull_up>;
                };
        };

	sdio-pwrseq {
		wifi_enable_h: wifi-enable-h {
			rockchip,pins = <3 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	wireless-bluetooth {
		uart9_gpios: uart9-gpios {
			rockchip,pins = <3 RK_PD2 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		bt_reset_gpio: bt-reset-gpio {
			rockchip,pins = <3 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		bt_wake_gpio: bt-wake-gpio {
			rockchip,pins = <3 RK_PC3 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		bt_irq_gpio: bt-irq-gpio {
			rockchip,pins = <3 RK_PC2 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	wireless-wlan {
		wifi_host_wake_irq: wifi-host-wake-irq {
			rockchip,pins = <0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};
};
