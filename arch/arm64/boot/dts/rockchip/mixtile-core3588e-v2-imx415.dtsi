/ {
	camera0_pwdn_gpio: camera0-pwdn-gpio {
		compatible = "regulator-fixed";
		regulator-name = "camera0_pwdn_gpio";
		regulator-always-on;
		regulator-boot-on;
		enable-active-high;
		gpio = <&gpio1 RK_PB0 GPIO_ACTIVE_HIGH>;
	};

	camera1_pwdn_gpio: camera1-pwdn-gpio {
		compatible = "regulator-fixed";
		regulator-name = "camera1_pwdn_gpio";
		regulator-always-on;
		regulator-boot-on;
		enable-active-high;
		gpio = <&gpio1 RK_PB1 GPIO_ACTIVE_HIGH>;
	};

	i2cmux1: i2cmux1 {
		compatible = "i2c-mux-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		i2c-parent = <&i2c2>;
		mux-gpios = <&gpio3 RK_PA2 GPIO_ACTIVE_HIGH>;

		i2c_cam0: i2c@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		i2c_cam1: i2c@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
		};
	};
};

&i2c2 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2m4_xfer>;
	status = "okay";
};

&rkcif {
	status = "okay";
};

&rkcif_mmu {
	status = "okay";
};

&rkisp0 {
	status = "okay";
};

&isp0_mmu {
	status = "okay";
};

&rkisp1 {
	status = "okay";
};

&isp1_mmu {
	status = "okay";
};

&i2c_cam0 {
	#address-cells = <1>;
	#size-cells = <0>;

	camera0_imx415: camera0-imx415@37 {
		compatible = "sony,imx415";
		reg = <0x37>;
		status = "okay";

		clocks = <&cru CLK_MIPI_CAMARAOUT_M0>;
		clock-names = "xvclk";
		pinctrl-names = "default";
		pinctrl-0 = <&mipim1_camera0_clk>;
		power-domains = <&power RK3588_PD_VI>;

		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "rpi-camera-v2";
		rockchip,camera-module-lens-name = "default";

		port {
			cam0_max9296_out: endpoint {
				remote-endpoint = <&cam0_mipi_in>;
				data-lanes = <1 2 3 4>;
			};
		};
	};
};

&csi2_dphy0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			cam0_mipi_in: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&cam0_max9296_out>;
				data-lanes = <1 2 3 4>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			cam0_csi_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&cam0_mipi2_input>;
			};
		};
	};
};

&mipi2_csi2 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			cam0_mipi2_input: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&cam0_csi_out>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			cam0_mipi2_output: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&cam0_cif_in>;
			};
		};
	};
};

&rkcif_mipi_lvds2 {
	status = "okay";

	port {
		cam0_cif_in: endpoint {
			remote-endpoint = <&cam0_mipi2_output>;
		};
	};
};

&rkcif_mipi_lvds2_sditf {
	status = "okay";

	port {
		mipi_lvds2_sditf: endpoint {
			remote-endpoint = <&isp0_vir0>;
		};
	};
};

&rkisp0_vir0 {
	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		isp0_vir0: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&mipi_lvds2_sditf>;
		};
	};
};

&i2c_cam1 {
	#address-cells = <1>;
	#size-cells = <0>;

	camera1_imx415: camera1-imx415@37 {
		compatible = "sony,imx415";
		reg = <0x37>;
		status = "okay";

		clocks = <&cru CLK_MIPI_CAMARAOUT_M0>;
		clock-names = "xvclk";
		pinctrl-names = "default";
		pinctrl-0 = <&mipim1_camera0_clk>;
		power-domains = <&power RK3588_PD_VI>;

		rockchip,camera-module-index = <1>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "rpi-camera-v2";
		rockchip,camera-module-lens-name = "default";

		port {
			cam1_max9296_out: endpoint {
				remote-endpoint = <&cam1_mipi_in>;
				data-lanes = <1 2 3 4>;
			};
		};
	};
};

&csi2_dphy0_hw {
	status = "okay";
};

&csi2_dphy3 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			cam1_mipi_in: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&cam1_max9296_out>;
				data-lanes = <1 2 3 4>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			cam1_csi_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&cam1_mipi4_input>;
			};
		};
	};
};

&mipi4_csi2 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			cam1_mipi4_input: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&cam1_csi_out>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			cam1_mipi4_output: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&cam1_cif_in>;
			};
		};
	};
};

&rkcif_mipi_lvds4 {
	status = "okay";

	port {
		cam1_cif_in: endpoint {
			remote-endpoint = <&cam1_mipi4_output>;
		};
	};
};

&rkcif_mipi_lvds4_sditf {
	status = "okay";

	port {
		mipi_lvds4_sditf: endpoint {
			remote-endpoint = <&isp1_vir0>;
		};
	};
};

&rkisp1_vir0 {
	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		isp1_vir0: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&mipi_lvds4_sditf>;
		};
	};
};
